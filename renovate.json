{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "baseBranchPatterns": ["main"],
  "tekton": {
    "enabled": true,
    "automerge": true,
    "schedule": ["* * * * *"]
  },
  "packageRules": [
    {
      "matchPackageNames": ["io.quarkus:quarkus-bom"],
      "postUpgradeTasks": {
        "commands": [
          "./mvnw validate -N -q -pl swatch-quarkus-parent"
        ],
        "executionMode": "branch"
      }
    }
  ]
}
