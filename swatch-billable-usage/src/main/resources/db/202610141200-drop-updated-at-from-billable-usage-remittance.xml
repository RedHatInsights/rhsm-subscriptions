<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

  <changeSet id="202610141000-001" author="vbusch">
    <preConditions onFail="MARK_RAN">
      <columnExists tableName="billable_usage_remittance" columnName="updated_at"/>
    </preConditions>
    <comment>Drop updated_at from billable_usage_remittance after migrating to last_modified</comment>
    <dropColumn tableName="billable_usage_remittance" columnName="updated_at"/>
    <rollback>
      <addColumn tableName="billable_usage_remittance">
        <column name="updated_at" type="timestamp">
          <constraints nullable="true"/>
        </column>
      </addColumn>
    </rollback>
  </changeSet>

</databaseChangeLog>
