<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
  xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">
  <changeSet id="202609300900-01" author="vbusch">
    <comment>Remove the unused product_id column from contracts</comment>
    <dropUniqueConstraint tableName="contracts" constraintName="contracts_logicalk"/>
    <addUniqueConstraint tableName="contracts"
                         columnNames="org_id, subscription_number, start_date, vendor_product_code"
                         constraintName="contracts_logicalk"/>
    <dropColumn tableName="contracts" columnName="product_id"/>

    <rollback>
      <dropUniqueConstraint tableName="contracts" constraintName="contracts_logicalk"/>
      <addColumn tableName="contracts">
        <column name="product_id" type="VARCHAR"/>
      </addColumn>
      <addUniqueConstraint tableName="contracts"
                           columnNames="subscription_number, start_date, product_id, vendor_product_code"
                           constraintName="contracts_logicalk"/>
    </rollback>
  </changeSet>
</databaseChangeLog>
